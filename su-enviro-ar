<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>EnviroAR - Syracuse University</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      overflow: hidden;
    }

    .container {
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      cursor: grab;
    }

    .container:active {
      cursor: grabbing;
    }

    .map-svg {
      transform-origin: 0 0;
    }

    .marker-group {
      cursor: pointer;
    }

    .marker-circle {
      transition: r 0.15s ease, filter 0.15s ease;
    }

    .marker-group:hover .marker-circle {
      r: 24;
    }

    .marker-label {
      font-size: 12px;
      font-weight: bold;
      fill: white;
      text-anchor: middle;
      dominant-baseline: central;
      pointer-events: none;
    }

    .building-label {
      font-size: 9px;
      fill: rgba(255, 255, 255, 0.4);
      font-family: system-ui;
    }

    .road-label {
      font-size: 8px;
      fill: rgba(255, 255, 255, 0.25);
      font-family: system-ui;
    }

    /* Zoom Controls */
    .zoom-controls {
      position: fixed;
      bottom: 80px;
      right: 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 50;
    }

    .zoom-btn {
      width: 36px;
      height: 36px;
      background: rgba(30, 41, 59, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      color: white;
      font-size: 20px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .zoom-btn:hover {
      background: rgba(50, 61, 79, 0.95);
    }

    #reset-view {
      font-size: 12px;
    }

    /* Popup Overlay */
    .popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      z-index: 99;
      display: none;
    }

    .popup-overlay.active {
      display: block;
    }

    /* Popup */
    .popup {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #1e293b;
      border-radius: 16px;
      padding: 20px;
      color: white;
      max-width: 360px;
      width: 90%;
      z-index: 100;
      display: none;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .popup.active {
      display: block;
    }

    .popup-close {
      position: absolute;
      top: 12px;
      right: 16px;
      background: none;
      border: none;
      color: rgba(255, 255, 255, 0.5);
      font-size: 24px;
      cursor: pointer;
    }

    .popup-close:hover {
      color: rgba(255, 255, 255, 0.8);
    }

    .popup-type {
      font-size: 10px;
      text-transform: uppercase;
      padding: 4px 8px;
      border-radius: 4px;
      display: inline-block;
      margin-bottom: 8px;
      font-weight: 600;
      color: white;
    }

    .type-campus {
      background: #f97316;
    }

    .type-energy {
      background: #eab308;
    }

    .popup h3 {
      font-size: 18px;
      margin-bottom: 4px;
      color: white;
    }

    .popup-sub {
      font-size: 11px;
      color: white;
      margin-bottom: 12px;
    }

    /* AQI Display */
    .aqi-row {
      display: flex;
      align-items: center;
      gap: 12px;
      background: rgba(255, 255, 255, 0.05);
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 12px;
    }

    .aqi-badge {
      width: 50px;
      height: 50px;
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .aqi-good {
      background: #22c55e;
    }

    .aqi-moderate {
      background: #eab308;
    }

    .aqi-badge .num {
      font-size: 20px;
      font-weight: bold;
      color: white;
    }

    .aqi-badge .lbl {
      font-size: 9px;
      color: white;
    }

    .aqi-info .level {
      font-weight: 600;
      font-size: 14px;
      color: white;
    }

    .aqi-info .trend {
      font-size: 11px;
      color: white;
    }

    /* Data Grid */
    .data-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      margin-bottom: 12px;
    }

    .data-item {
      background: rgba(255, 255, 255, 0.05);
      padding: 8px;
      border-radius: 6px;
    }

    .data-item .label {
      font-size: 9px;
      color: white;
      text-transform: uppercase;
    }

    .data-item .value {
      font-size: 13px;
      font-weight: 600;
      color: white;
    }

    /* Story Box */
    .story {
      background: linear-gradient(to right, rgba(249, 115, 22, 0.15), transparent);
      border-left: 3px solid #f97316;
      padding: 10px;
      border-radius: 6px;
      font-size: 12px;
      line-height: 1.5;
      color: white;
    }

    /* Info Panel */
    .info-panel {
      position: fixed;
      top: 12px;
      right: 12px;
      background: rgba(30, 41, 59, 0.95);
      padding: 14px;
      border-radius: 12px;
      color: white;
      z-index: 50;
      max-width: 200px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .info-panel h3 {
      font-size: 14px;
      margin-bottom: 6px;
      color: white;
    }

    .info-panel p {
      font-size: 9px;
      color: white;
      line-height: 1.4;
    }

    .campus-avg {
      margin-top: 10px;
      padding: 8px;
      background: rgba(34, 197, 94, 0.1);
      border-radius: 8px;
    }

    .campus-avg .label {
      font-size: 8px;
      color: white;
      display: block;
    }

    .campus-avg .value {
      font-size: 22px;
      font-weight: bold;
      color: #4ade80;
      display: block;
    }

    .campus-avg .sub {
      font-size: 9px;
      color: #4ade80;
      display: block;
    }

    /* Legend */
    .legend {
      position: fixed;
      bottom: 12px;
      left: 12px;
      background: rgba(30, 41, 59, 0.95);
      padding: 10px;
      border-radius: 10px;
      color: white;
      z-index: 50;
      font-size: 11px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .legend h4 {
      margin-bottom: 5px;
      font-size: 12px;
      color: white;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 5px;
      margin-bottom: 4px;
    }

    .legend-item span {
      color: white;
    }

    .legend-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
    }

    .green-dot {
      background: #22c55e;
    }

    .yellow-dot {
      background: #eab308;
    }

    /* Hint */
    .hint {
      position: fixed;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      background: rgba(30, 41, 59, 0.9);
      padding: 8px 16px;
      border-radius: 20px;
      color: rgba(255, 255, 255, 0.6);
      font-size: 11px;
      z-index: 50;
      pointer-events: none;
      transition: opacity 0.3s;
    }
  </style>
</head>
<body>
  <div class="container" id="container">
    <svg class="map-svg" id="map" viewBox="0 0 800 600">
      <defs>
        <filter id="glow-green">
          <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
          <feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="glow-yellow">
          <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
          <feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      
      <rect width="800" height="600" fill="#16213e"/>
      
      <g fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="8">
        <path d="M0 320 L800 320"/>
        <path d="M0 480 L800 480"/>
        <path d="M180 0 L180 600"/>
        <path d="M400 100 L400 500"/>
        <path d="M580 0 L580 600"/>
      </g>
      
      <text x="90" y="310" class="road-label">University Ave</text>
      <text x="170" y="200" class="road-label" transform="rotate(-90, 170, 200)">Comstock</text>
      <text x="390" y="150" class="road-label" transform="rotate(-90, 390, 150)">Crouse</text>
      
      <ellipse cx="350" cy="260" rx="100" ry="60" fill="rgba(34,197,94,0.08)"/>
      
      <ellipse cx="220" cy="340" rx="55" ry="45" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.1)"/>
      <text x="220" y="395" class="building-label" text-anchor="middle">Carrier Dome</text>
      
      <rect x="195" y="420" width="50" height="35" rx="3" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.1)"/>
      <text x="220" y="470" class="building-label" text-anchor="middle">Ernie Davis</text>
      
      <rect x="320" y="180" width="60" height="40" rx="3" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
      <text x="350" y="175" class="building-label" text-anchor="middle">Hall of Languages</text>
      
      <rect x="300" y="230" width="100" height="70" rx="5" fill="none" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 2"/>
      <text x="350" y="270" class="building-label" text-anchor="middle">Quad</text>
      
      <rect x="420" y="220" width="55" height="50" rx="3" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
      <text x="447" y="285" class="building-label" text-anchor="middle">Bird Library</text>
      
      <rect x="330" y="310" width="40" height="30" rx="3" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
      <text x="350" y="355" class="building-label" text-anchor="middle">Hendricks</text>
      
      <rect x="250" y="230" width="40" height="45" rx="3" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
      <text x="270" y="290" class="building-label" text-anchor="middle">Crouse</text>
      
      <rect x="520" y="200" width="70" height="55" rx="3" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.1)"/>
      <text x="555" y="270" class="building-label" text-anchor="middle">CST</text>
      
      <rect x="520" y="270" width="50" height="35" rx="3" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.1)"/>
      <text x="545" y="320" class="building-label" text-anchor="middle">Link Hall</text>
      
      <rect x="470" y="100" width="45" height="35" rx="3" fill="rgba(255,255,255,0.04)" stroke="rgba(234,179,8,0.2)"/>
      <text x="492" y="150" class="building-label" text-anchor="middle">Steam Station</text>
      
      <text x="650" y="550" fill="rgba(255,255,255,0.2)" font-size="11" font-family="system-ui">South Campus →</text>
      <text x="650" y="565" fill="rgba(255,255,255,0.12)" font-size="9" font-family="system-ui">(Solar apartments)</text>
      
      <text x="400" y="60" fill="rgba(255,255,255,0.2)" font-size="16" font-weight="600" text-anchor="middle" font-family="system-ui">SYRACUSE UNIVERSITY</text>
      
      <g class="marker-group" data-location="quad">
        <circle class="marker-circle" cx="350" cy="260" r="20" fill="#22c55e" stroke="white" stroke-width="2.5" filter="url(#glow-green)"/>
        <text x="350" y="260" class="marker-label">42</text>
      </g>
      
      <g class="marker-group" data-location="bird">
        <circle class="marker-circle" cx="447" cy="245" r="20" fill="#22c55e" stroke="white" stroke-width="2.5" filter="url(#glow-green)"/>
        <text x="447" y="245" class="marker-label">40</text>
      </g>
      
      <g class="marker-group" data-location="cst">
        <circle class="marker-circle" cx="555" cy="227" r="20" fill="#22c55e" stroke="white" stroke-width="2.5" filter="url(#glow-green)"/>
        <text x="555" y="227" class="marker-label">45</text>
      </g>
      
      <g class="marker-group" data-location="dome">
        <circle class="marker-circle" cx="220" cy="340" r="20" fill="#22c55e" stroke="white" stroke-width="2.5" filter="url(#glow-green)"/>
        <text x="220" y="340" class="marker-label">44</text>
      </g>
      
      <g class="marker-group" data-location="ernie">
        <circle class="marker-circle" cx="220" cy="437" r="20" fill="#22c55e" stroke="white" stroke-width="2.5" filter="url(#glow-green)"/>
        <text x="220" y="437" class="marker-label">38</text>
      </g>
      
      <g class="marker-group" data-location="steam">
        <circle class="marker-circle" cx="492" cy="117" r="20" fill="#eab308" stroke="white" stroke-width="2.5" filter="url(#glow-yellow)"/>
        <text x="492" y="117" class="marker-label">68</text>
      </g>
      
      <g class="marker-group" data-location="south">
        <circle class="marker-circle" cx="720" cy="540" r="20" fill="#22c55e" stroke="white" stroke-width="2.5" filter="url(#glow-green)"/>
        <text x="720" y="540" class="marker-label">35</text>
      </g>
    </svg>
  </div>
  
  <div class="info-panel">
    <h3>🌿 EnviroAR Syracuse</h3>
    <p>Drag to pan, scroll to zoom. Click markers for data.</p>
    <div class="campus-avg">
      <span class="label">CAMPUS AVG AQI</span>
      <span class="value">38</span>
      <span class="sub">Good · 12% better than city</span>
    </div>
  </div>
  
  <div class="legend">
    <h4>Air Quality</h4>
    <div class="legend-item"><div class="legend-dot green-dot"></div><span>Good (0-50)</span></div>
    <div class="legend-item"><div class="legend-dot yellow-dot"></div><span>Moderate (51-100)</span></div>
  </div>
  
  <div class="zoom-controls">
    <button class="zoom-btn" id="zoom-in">+</button>
    <button class="zoom-btn" id="zoom-out">−</button>
    <button class="zoom-btn" id="reset-view">⟲</button>
  </div>
  
  <div class="hint" id="hint">Drag to pan • Scroll to zoom</div>
  
  <div class="popup-overlay" id="popup-overlay"></div>
  <div class="popup" id="popup">
    <button class="popup-close" id="popup-close">×</button>
    <div id="popup-content"></div>
  </div>

  <script>
    const locationData = {
      quad: {
        name: 'Main Quad', type: 'campus', aqi: 42, level: 'Good',
        pm25: 8.2, co2: 412, temp: 34, humidity: 65,
        story: '47 mature trees absorb ~24 tons of CO₂ annually—equivalent to driving 52,000 miles.'
      },
      bird: {
        name: 'Bird Library', type: 'campus', aqi: 40, level: 'Good',
        pm25: 7.5, co2: 418, temp: 70, humidity: 45,
        story: 'LED lighting on first floor cut energy use by nearly 70%.'
      },
      cst: {
        name: 'Center for Science & Tech', type: 'energy', aqi: 45, level: 'Good',
        pm25: 9.1, co2: 428, temp: 72, humidity: 42,
        story: 'Heat recovery loop captures exhaust heat. 2019-2024 HVAC upgrade cut steam usage significantly.'
      },
      dome: {
        name: 'JMA Wireless Dome', type: 'campus', aqi: 44, level: 'Good',
        pm25: 8.8, co2: 422, temp: 68, humidity: 52,
        story: '49,000+ capacity. Game days create temporary AQ impacts. Renovated 2020-22.'
      },
      ernie: {
        name: 'Ernie Davis Hall', type: 'campus', aqi: 38, level: 'Good',
        pm25: 6.8, co2: 405, temp: 71, humidity: 48,
        story: 'LEED-certified. HVAC sensors recalibrated to reduce excess energy consumption.'
      },
      steam: {
        name: 'SU Steam Station', type: 'energy', aqi: 68, level: 'Moderate',
        pm25: 18.4, co2: 485, temp: 38, humidity: 58,
        story: 'Burns natural gas for heating—biggest campus GHG source. 60% of emissions. Target: carbon neutral 2032.'
      },
      south: {
        name: 'South Campus', type: 'energy', aqi: 35, level: 'Good',
        pm25: 6.1, co2: 398, temp: 32, humidity: 68,
        story: '240 solar panels heat water for 160 apartments, avoiding 125 tons GHG/year. DOE net-zero retrofit underway.'
      }
    };

    const svg = document.getElementById('map');
    const container = document.getElementById('container');
    const popup = document.getElementById('popup');
    const popupOverlay = document.getElementById('popup-overlay');
    const popupContent = document.getElementById('popup-content');
    const hint = document.getElementById('hint');

    let scale = 1.5;
    let panX = -200;
    let panY = -100;
    let isDragging = false;
    let startX, startY;

    function updateTransform() {
      svg.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
    }

    updateTransform();

    setTimeout(() => { hint.style.opacity = '0'; }, 3000);

    container.addEventListener('mousedown', (e) => {
      if (e.target.closest('.marker-group')) return;
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
    });

    container.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      updateTransform();
    });

    container.addEventListener('mouseup', () => { isDragging = false; });
    container.addEventListener('mouseleave', () => { isDragging = false; });

    container.addEventListener('touchstart', (e) => {
      if (e.target.closest('.marker-group')) return;
      isDragging = true;
      startX = e.touches[0].clientX - panX;
      startY = e.touches[0].clientY - panY;
    });

    container.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      panX = e.touches[0].clientX - startX;
      panY = e.touches[0].clientY - startY;
      updateTransform();
    });

    container.addEventListener('touchend', () => { isDragging = false; });

    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      const delta = e.deltaY > 0 ? 0.9 : 1.1;
      const newScale = Math.min(Math.max(scale * delta, 0.8), 4);
      const rect = container.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;
      panX = mouseX - (mouseX - panX) * (newScale / scale);
      panY = mouseY - (mouseY - panY) * (newScale / scale);
      scale = newScale;
      updateTransform();
    });

    document.getElementById('zoom-in').addEventListener('click', () => {
      scale = Math.min(scale * 1.3, 4);
      updateTransform();
    });

    document.getElementById('zoom-out').addEventListener('click', () => {
      scale = Math.max(scale * 0.7, 0.8);
      updateTransform();
    });

    document.getElementById('reset-view').addEventListener('click', () => {
      scale = 1.5;
      panX = -200;
      panY = -100;
      updateTransform();
    });

    document.querySelectorAll('.marker-group').forEach(marker => {
      marker.addEventListener('click', () => {
        showPopup(marker.dataset.location);
      });
    });

    function showPopup(id) {
      const d = locationData[id];
      if (!d) return;
      
      const aqiClass = d.aqi <= 50 ? 'aqi-good' : 'aqi-moderate';
      const typeLabel = d.type === 'campus' ? 'Campus Building' : 'Energy/Emissions';
      
      popupContent.innerHTML = `
        <span class="popup-type type-${d.type}">${typeLabel}</span>
        <h3>${d.name}</h3>
        <p class="popup-sub">Environmental data</p>
        <div class="aqi-row">
          <div class="aqi-badge ${aqiClass}">
            <span class="num">${d.aqi}</span>
            <span class="lbl">AQI</span>
          </div>
          <div class="aqi-info">
            <div class="level">${d.level}</div>
            <div class="trend">Updated: Just now</div>
          </div>
        </div>
        <div class="data-grid">
          <div class="data-item">
            <div class="label">PM2.5</div>
            <div class="value">${d.pm25} µg/m³</div>
          </div>
          <div class="data-item">
            <div class="label">CO₂</div>
            <div class="value">${d.co2} ppm</div>
          </div>
          <div class="data-item">
            <div class="label">Temp</div>
            <div class="value">${d.temp}°F</div>
          </div>
          <div class="data-item">
            <div class="label">Humidity</div>
            <div class="value">${d.humidity}%</div>
          </div>
        </div>
        <div class="story">${d.story}</div>
      `;
      
      popup.classList.add('active');
      popupOverlay.classList.add('active');
    }

    function closePopup() {
      popup.classList.remove('active');
      popupOverlay.classList.remove('active');
    }

    document.getElementById('popup-close').addEventListener('click', closePopup);
    popupOverlay.addEventListener('click', closePopup);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePopup(); });
  </script>
</body>
</html>
